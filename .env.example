POSTGRES_USER=yukino
POSTGRES_PASSWORD=yukino
POSTGRES_DB=yukino_agent
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=12345678
MINIO_PUBLIC_URL=http://localhost:9000

# Shared host HTTP/mixed proxy for ubuntu22 and ubuntu24 (local Clash Verge port).
# Set to an empty value to disable the container proxy environment variables.
UBUNTU_PROXY_URL=http://host.docker.internal:7897

LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_SALT=replace-with-a-random-value
LANGFUSE_ENCRYPTION_KEY=replace-with-64-hex-characters
LANGFUSE_NEXTAUTH_SECRET=replace-with-a-random-value
LANGFUSE_CLICKHOUSE_PASSWORD=replace-with-a-random-value
LANGFUSE_USER_EMAIL=dev@yukino.local
LANGFUSE_USER_PASSWORD=replace-with-a-local-login-password
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-a-random-value
LANGFUSE_SECRET_KEY=sk-lf-replace-with-a-random-value
LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_FLUSH_AT=1
LANGFUSE_FLUSH_INTERVAL=1
